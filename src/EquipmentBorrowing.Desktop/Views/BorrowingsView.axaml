<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

	<StackPanel Margin="20" Spacing="15">
		<TextBlock Text="Active Borrowings" FontSize="20" FontWeight="Bold"/>

		<ListBox ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedBorrowing}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<!-- Student ID -->
						<TextBlock Text="{Binding StudentId}" FontWeight="Bold"/>
						<TextBlock Text="-"/>
						<!-- Student Name -->
						<TextBlock Text="{Binding Student.Name}" FontWeight="SemiBold"/>
						<TextBlock Text="-"/>
						<!-- Equipment Name -->
						<TextBlock Text="{Binding Equipment.Name}"/>
						<TextBlock Text="-"/>
						<!-- Date Borrowed -->
						<TextBlock Text="{Binding BorrowedDate, StringFormat=\{0:MM/dd/yyyy\}}"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<Button Content="Return Equipment" Command="{Binding ReturnCommand}" HorizontalAlignment="Left" Padding="10,5"/>
		<TextBlock Text="{Binding StatusMessage}" Foreground="Blue" FontWeight="SemiBold"/>
	</StackPanel>
</UserControl>