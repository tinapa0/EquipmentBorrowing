<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

	<StackPanel Margin="20" Spacing="15">
		<TextBlock Text="Available Equipment" FontSize="20" FontWeight="Bold"/>

		<!-- Added Height="200" so the ListBox renders its items immediately on startup -->
		<ListBox ItemsSource="{Binding EquipmentList}"
				 SelectedItem="{Binding SelectedEquipment}"
				 Height="200">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<!-- 1. Equipment ID -->
						<TextBlock Text="{Binding Id}" FontWeight="Bold"/>
						<TextBlock Text="-"/>

						<!-- 2. Equipment Name -->
						<TextBlock Text="{Binding Name}"/>
						<TextBlock Text="-"/>

						<!-- 3. Equipment Status -->
						<TextBlock Text="[Available]" Foreground="Green" IsVisible="{Binding IsAvailable}"/>
						<TextBlock Text="[Borrowed]" Foreground="Red" IsVisible="{Binding !IsAvailable}"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<TextBlock Text="Borrowing Details" FontSize="16" FontWeight="Bold"/>

		<ComboBox ItemsSource="{Binding StudentList}"
				  SelectedValue="{Binding SelectedStudentId}"
				  SelectedValueBinding="{Binding Id}"
				  PlaceholderText="Select Student"
				  HorizontalAlignment="Stretch">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding FullName}"/>
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>

		<DatePicker SelectedDate="{Binding ExpectedReturnDate}"/>

		<Button Content="Borrow Equipment" Command="{Binding BorrowCommand}" HorizontalAlignment="Left" Padding="10,5"/>
		<TextBlock Text="{Binding StatusMessage}" Foreground="Blue" FontWeight="SemiBold"/>
	</StackPanel>
</UserControl>