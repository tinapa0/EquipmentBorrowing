<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingSearchView"
             x:DataType="vm:BorrowingSearchViewModel">

	<Grid Margin="15" RowDefinitions="Auto, Auto, *, Auto">
		<!-- Title -->
		<TextBlock Grid.Row="0" Text="Search, Filter, and Sort Borrowings (UC-09)" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

		<!-- Controls Panel: Search, Filter, Sort -->
		<Border Grid.Row="1" Background="#F9F9FB" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,15">
			<WrapPanel Orientation="Horizontal" ItemWidth="200" ItemHeight="60">
				<!-- Search Input -->
				<StackPanel Margin="0,0,15,0">
					<TextBlock Text="Search (Student / Equipment)" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
					<TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Type to search..."/>
				</StackPanel>

				<!-- Status Filter -->
				<StackPanel Margin="0,0,15,0">
					<TextBlock Text="Status Filter" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
					<ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
				</StackPanel>

				<!-- Sort Field -->
				<StackPanel Margin="0,0,15,0">
					<TextBlock Text="Sort By" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
					<ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortField, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
				</StackPanel>

				<!-- Direction & Reset -->
				<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
					<CheckBox Content="Ascending" IsChecked="{Binding IsAscending, Mode=TwoWay}" VerticalAlignment="Center"/>
					<Button Content="Reset" Command="{Binding ClearCriteriaCommand}" VerticalAlignment="Center" Background="#DDDDDD"/>
				</StackPanel>
			</WrapPanel>
		</Border>

		<!-- Results List -->
		<Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10">
			<ListBox ItemsSource="{Binding FilteredBorrowings}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="8" Margin="0,2">
							<Grid ColumnDefinitions="*, *, *, *, *">
								<StackPanel Grid.Column="0">
									<TextBlock Text="Student:" FontSize="10" Foreground="Gray"/>
									<TextBlock Text="{Binding Student.FullName}" FontWeight="Bold"/>
								</StackPanel>
								<StackPanel Grid.Column="1">
									<TextBlock Text="Equipment:" FontSize="10" Foreground="Gray"/>
									<TextBlock Text="{Binding Equipment.Name}" FontWeight="Bold"/>
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Borrowed Date:" FontSize="10" Foreground="Gray"/>
									<TextBlock Text="{Binding BorrowedDate, StringFormat='d'}"/>
								</StackPanel>
								<StackPanel Grid.Column="3">
									<TextBlock Text="Expected Return:" FontSize="10" Foreground="Gray"/>
									<TextBlock Text="{Binding ExpectedReturnDate, StringFormat='d'}"/>
								</StackPanel>
								<StackPanel Grid.Column="4">
									<TextBlock Text="Status:" FontSize="10" Foreground="Gray"/>
									<TextBlock Text="{Binding Status}" FontWeight="Bold"/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<!-- Status Footer -->
		<TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="DarkBlue" FontWeight="Bold" Margin="0,15,0,0"/>
	</Grid>
</UserControl>