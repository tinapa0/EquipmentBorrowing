<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentManagementView"
             x:DataType="vm:EquipmentManagementViewModel">

	<Grid Margin="15" RowDefinitions="Auto, *, Auto" ColumnDefinitions="*, 340">
		<!-- Title -->
		<TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Equipment Management (UC-15 to UC-16)" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

		<!-- Left: Equipment List -->
		<Border Grid.Row="1" Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,15,0">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="Inventory List (Select to Edit)" FontWeight="Bold" Margin="0,0,0,8"/>
				<ListBox ItemsSource="{Binding EquipmentList}" SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}" SelectionMode="Single">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="{Binding EquipmentIdentifier}" FontWeight="Bold"/>
								<TextBlock Text="{Binding Name}"/>
								<TextBlock Text="{Binding Description}" Foreground="DimGray"/>
								<TextBlock Text="{Binding IsAvailable, StringFormat='[Available: {0}]'}" Foreground="Green"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>

		<!-- Right: Register & Edit Equipment Panel -->
		<Border Grid.Row="1" Grid.Column="1" Background="#F9F9FB" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="15">
			<ScrollViewer>
				<StackPanel Spacing="10">
					<TextBlock Text="Equipment Details" FontWeight="Bold" FontSize="14"/>

					<TextBlock Text="Identifier * (e.g., EQ-006)"/>
					<TextBox Text="{Binding Identifier, Mode=TwoWay}"/>

					<TextBlock Text="Name *"/>
					<TextBox Text="{Binding Name, Mode=TwoWay}"/>

					<TextBlock Text="Description (Optional)"/>
					<TextBox Text="{Binding Description, Mode=TwoWay}" Watermark="Leave blank to clear"/>

					<TextBlock Text="{Binding SelectedIsAvailable, StringFormat='Current Availability: {0} (Managed by Borrow/Return)'}" Foreground="Gray" FontSize="12"/>

					<Button Content="Register New Equipment (UC-15)" Command="{Binding RegisterEquipmentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
					<Button Content="Save Changes to Selected (UC-16)" Command="{Binding UpdateEquipmentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
					<Button Content="Clear Selection / Form" Command="{Binding ClearFormCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- Status Footer -->
		<TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="DarkBlue" Margin="0,12,0,0"/>
	</Grid>
</UserControl>