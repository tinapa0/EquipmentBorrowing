<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentManagementView"
             x:DataType="vm:EquipmentManagementViewModel">

	<Grid Margin="15" RowDefinitions="Auto, *, Auto, Auto" ColumnDefinitions="*, 300">
		<!-- Title -->
		<TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Equipment Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

		<!-- Left: Equipment List -->
		<Border Grid.Row="1" Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,15,0">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="Inventory List" FontWeight="Bold" Margin="0,0,0,8"/>
				<ListBox ItemsSource="{Binding EquipmentList}" SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}" SelectionMode="Single">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="{Binding EquipmentIdentifier}" FontWeight="Bold"/>
								<TextBlock Text="{Binding Name}"/>
								<TextBlock Text="{Binding IsAvailable, StringFormat='[Available: {0}]'}" Foreground="Green"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>

		<!-- Right: Register New Equipment Panel -->
		<Border Grid.Row="1" Grid.Column="1" Background="#F9F9FB" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="15">
			<StackPanel Spacing="12">
				<TextBlock Text="Register Equipment" FontWeight="Bold" FontSize="14"/>
				
				<TextBlock Text="Identifier (e.g. EQ-103):"/>
				<TextBox Text="{Binding Identifier, Mode=TwoWay}"/>

				<TextBlock Text="Name:"/>
				<TextBox Text="{Binding Name, Mode=TwoWay}"/>

				<TextBlock Text="Description:"/>
				<TextBox Text="{Binding Description, Mode=TwoWay}"/>

				<CheckBox Content="Is Available" IsChecked="{Binding IsAvailable, Mode=TwoWay}"/>

				<Button Content="Register Equipment" Command="{Binding RegisterEquipmentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
			</StackPanel>
		</Border>

		<!-- Status Footer -->
		<TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" Foreground="DarkBlue" Margin="0,15,0,0"/>
	</Grid>
</UserControl>