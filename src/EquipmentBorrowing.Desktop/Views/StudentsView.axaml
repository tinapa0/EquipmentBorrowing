<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.StudentsView"
             x:DataType="vm:StudentsViewModel">

	<Grid Margin="15" RowDefinitions="Auto, *, Auto, Auto" ColumnDefinitions="*, 300">
		<!-- Title -->
		<TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Student Management" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

		<!-- Left: Student List -->
		<Border Grid.Row="1" Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,15,0">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="Registered Students" FontWeight="Bold" Margin="0,0,0,8"/>
				<ListBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" SelectionMode="Single">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
								<TextBlock Text="{Binding StudentNumber}" Foreground="Gray"/>
								<TextBlock Text="{Binding IsAllowedToBorrow, StringFormat='[Eligible: {0}]'}" Foreground="Green"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</Border>

		<!-- Right: Register Panel -->
		<Border Grid.Row="1" Grid.Column="1" Background="#F9F9FB" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="15">
			<StackPanel Spacing="12">
				<TextBlock Text="Register New Student" FontWeight="Bold" FontSize="14"/>

				<TextBlock Text="Full Name:"/>
				<TextBox Text="{Binding FullName, Mode=TwoWay}"/>

				<TextBlock Text="Student Number:"/>
				<TextBox Text="{Binding StudentNumber, Mode=TwoWay}"/>

				<CheckBox Content="Is Allowed to Borrow" IsChecked="{Binding IsAllowedToBorrow, Mode=TwoWay}"/>

				<Button Content="Register Student" Command="{Binding RegisterStudentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
			</StackPanel>
		</Border>

		<!-- Status Message Footer -->
		<TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" Foreground="DarkBlue" Margin="0,15,0,0"/>
	</Grid>
</UserControl>