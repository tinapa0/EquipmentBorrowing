<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System" Width="850" Height="550">

	<Window.Styles>
		<!-- Shared Navigation Button Styling -->
		<Style Selector="Button.nav">
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="CornerRadius" Value="5"/>
		</Style>
	</Window.Styles>

	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
			<views:EquipmentView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:BorrowingsViewModel}">
			<views:BorrowingsView />
		</DataTemplate>
	</Window.DataTemplates>

	<Grid ColumnDefinitions="220, *">
		<!-- Sidebar Navigation Area -->
		<Border Grid.Column="0" Background="#F4F4F6" Padding="15">
			<StackPanel Spacing="12">
				<TextBlock Text="Navigation" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

				<Button Content="Equipment List"
                        Command="{Binding NavigateToEquipmentCommand}"
                        Classes="nav"/>

				<Button Content="Active Borrowings"
                        Command="{Binding NavigateToBorrowingsCommand}"
                        Classes="nav"/>
			</StackPanel>
		</Border>

		<!-- Dynamic Content View Area -->
		<TransitioningContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="10"/>
	</Grid>
</Window>