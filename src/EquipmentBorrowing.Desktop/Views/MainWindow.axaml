<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System" Width="800" Height="500">

	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type vm:EquipmentViewModel}">
			<views:EquipmentView />
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:BorrowingsViewModel}">
			<views:BorrowingsView />
		</DataTemplate>
	</Window.DataTemplates>

	<Grid ColumnDefinitions="200, *">
		<!-- Sidebar Navigation -->
		<StackPanel Grid.Column="0" Background="#F0F0F0" Spacing="10" Margin="10">
			<TextBlock Text="Menu" FontSize="18" FontWeight="Bold" Margin="10"/>
			<Button Content="Equipment" Command="{Binding NavigateToEquipmentCommand}" HorizontalAlignment="Stretch"/>
			<Button Content="Active Borrowings" Command="{Binding NavigateToBorrowingsCommand}" HorizontalAlignment="Stretch"/>
		</StackPanel>

		<!-- Main Content Area -->
		<TransitioningContentControl Grid.Column="1" Content="{Binding CurrentView}" />
	</Grid>
</Window>