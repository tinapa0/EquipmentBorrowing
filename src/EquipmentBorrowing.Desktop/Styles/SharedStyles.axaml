<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls">

  <!-- Color brushes -->
  <SolidColorBrush x:Key="HeaderBackground" Color="#2D3748" />
  <SolidColorBrush x:Key="NavigationBackground" Color="#FAFAFA" />
  <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="StatusForeground" Color="#333333" />

	<!-- Text styles intentionally removed to avoid build-time type resolution issues. Use inline properties in views. -->

</ResourceDictionary>
